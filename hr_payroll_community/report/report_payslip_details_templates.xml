<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Template for Payslip Details Report-->
    <template id="report_payslipdetails">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">

                <style>

                    .page {
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 12px;
                        color: #000;
                        padding-left: 40px;
                        padding-right: 40px;
                    }

                    table {
                        width: 100%;
                        border-spacing: 0;
                        border-collapse: separate;
                    }

                    td, th {
                        border: none !important;
                        padding: 2px 4px;
                        vertical-align: top;
                    }

                    .top-header {
                        border-top: 1px solid #000;
                        margin-top: 10px;
                    }

                    .top-header td {
                        padding-top: 10px;
                        padding-bottom: 10px;
                    }

                    .employee-section {
                        border-bottom: 1px solid #000;
                        margin-top: 8px;
                        padding-bottom: 6px;
                    }

                    .section-title {
                        font-weight: bold;
                    }

                    .table-head th {
                        border-bottom: 1px solid #000 !important;
                        font-weight: bold;
                        padding-bottom: 4px;
                    }

                    .text-right {
                        text-align: right;
                    }

                    .text-left {
                        text-align: left;
                    }

                    .left-block {
                        width: 53%;
                        vertical-align: top;
                        padding-right: 15px;
                    }

                    .right-block {
                        width: 47%;
                        vertical-align: top;
                        padding-left: 10px;
                    }

                    .line-separator td {
                        border-top: 1px solid #000 !important;
                        padding-top: 4px;
                    }

                    .netpay {
                        margin-top: 22px;
                    }

                    .netpay td {
                        font-weight: bold;
                        font-size: 14px;
                    }

                </style>

                <div class="page">

                    <div style="margin-bottom:10px; margin-left:10px;">
                        <div>
                            <strong t-field="o.employee_id.name"/>
                        </div>
                        <div t-field="o.employee_id.private_street"/>
                        <div>
                            <span t-field="o.employee_id.private_city"/>
                            <span t-field="o.employee_id.private_state_id"/>
                            <span t-field="o.employee_id.private_zip"/>
                        </div>
                    </div>

                    <table class="top-header">
                        <tr>
                            <td width="24%" class="section-title">
                                Employee Paystub
                            </td>

                            <td width="22%">
                                Cheque number:
                            </td>

                            <td width="34%">
                                Pay Period:
                                <span t-field="o.date_from"/>
                                -
                                <span t-field="o.date_to"/>
                            </td>

                            <td width="20%" class="text-right">
                                Cheque Date:
                                <span t-field="o.date_to"/>
                            </td>
                        </tr>
                    </table>

                    <table class="employee-table">
                        <tr>
                            <td width="50%" class="section-title">
                                Employee
                            </td>

                            <td width="50%" class="section-title">
                                Occupation
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span t-field="o.employee_id.name"/>

                                <t t-if="o.employee_id.private_city">
                                    ,
                                    <span t-field="o.employee_id.private_city"/>
                                </t>

                                <t t-if="o.employee_id.private_state_id">
                                    ,
                                    <span t-field="o.employee_id.private_state_id"/>
                                </t>

                                <t t-if="o.employee_id.private_zip">
                                    ,
                                    <span t-field="o.employee_id.private_zip"/>
                                </t>
                            </td>

                            <td>
                                <span t-field="o.employee_id.job_id"/>
                            </td>
                        </tr>
                    </table>

                    <div class="spacer"></div>

                    <table>
                        <tr>

                            <td class="left-side">

                                <table>

                                    <thead class="table-head">
                                        <tr>
                                            <th class="text-left">Earnings and Hours</th>
                                            <th class="text-right">Qty</th>
                                            <th class="text-right">Rate</th>
                                            <th class="text-right">Current</th>
                                            <th class="text-right">YTD Amount</th>
                                        </tr>
                                    </thead>

                                    <tbody class="table-body">

                                        <t t-set="gross_total" t-value="0"/>

                                        <t t-foreach="o.line_ids.filtered(lambda l: l.total &gt; 0)" t-as="line">

                                            <tr>
                                                <td>
                                                    <span t-field="line.name"/>
                                                </td>

                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.quantity"/>
                                                </td>

                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.amount"/>
                                                </td>

                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.total"/>
                                                </td>

                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.total"/>
                                                </td>
                                            </tr>

                                            <t t-set="gross_total"
                                               t-value="gross_total + line.total"/>

                                        </t>

                                        <tr class="line-total">
                                            <td colspan="3"></td>

                                            <td class="text-right">
                                                <strong>
                                                    <span t-esc="'%.2f' % gross_total"/>
                                                </strong>
                                            </td>

                                            <td class="text-right">
                                                <strong>
                                                    <span t-esc="'%.2f' % gross_total"/>
                                                </strong>
                                            </td>
                                        </tr>

                                    </tbody>

                                </table>

                                <table style="margin-top:18px;">

                                    <thead class="table-head">
                                        <tr>
                                            <th class="text-left">
                                                Withholdings
                                            </th>

                                            <th class="text-right">
                                                Current
                                            </th>

                                            <th class="text-right">
                                                YTD Amount
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody class="table-body">

                                        <t t-set="ded_total" t-value="0"/>

                                        <t t-foreach="o.line_ids.filtered(lambda l: l.total &lt; 0)" t-as="line">

                                            <tr>
                                                <td>
                                                    <span t-field="line.name"/>
                                                </td>

                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.total"/>
                                                </td>

                                                <td class="text-right">
                                                    <span t-esc="'%.2f' % line.total"/>
                                                </td>
                                            </tr>

                                            <t t-set="ded_total"
                                               t-value="ded_total + line.total"/>

                                        </t>

                                        <tr class="line-total">
                                            <td></td>

                                            <td class="text-right">
                                                <strong>
                                                    <span t-esc="'%.2f' % ded_total"/>
                                                </strong>
                                            </td>

                                            <td class="text-right">
                                                <strong>
                                                    <span t-esc="'%.2f' % ded_total"/>
                                                </strong>
                                            </td>
                                        </tr>

                                    </tbody>

                                </table>

                                <table class="netpay">

                                    <t t-set="net_pay"
                                       t-value="sum(o.line_ids.filtered(lambda l: l.code == 'NET').mapped('total'))"/>

                                    <tr>

                                        <td width="70%">
                                            Net Pay
                                        </td>

                                        <td width="15%" class="text-right">
                                            <span t-esc="'%.2f' % net_pay"/>
                                        </td>

                                        <td width="15%" class="text-right">
                                            <span t-esc="'%.2f' % net_pay"/>
                                        </td>

                                    </tr>

                                </table>

                            </td>

                            <td class="right-side">

                                <table>

                                    <thead class="table-head">
                                        <tr>
                                            <th class="text-left">
                                                Sick Hours and Vacation Pay
                                            </th>

                                            <th class="text-right">
                                                Earned
                                            </th>

                                            <th class="text-right">
                                                YTD Used
                                            </th>

                                            <th class="text-right">
                                                Available
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody class="table-body">

                                        <t t-set="sl_line"
                                        t-value="o.line_ids.filtered(lambda l: l.code == 'SL')[:1]"/>

                                        <tr>
                                            <td>Sick (hrs)</td>

                                            <td class="text-right">
                                                <t t-if="sl_line">
                                                    <span t-esc="'%.2f' % sl_line.total"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>

                                            <td class="text-right">
                                                <t t-if="sl_line">
                                                    <span t-esc="'%.2f' % sl_line.amount"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>

                                            <td class="text-right">
                                                <t t-if="sl_line">
                                                    <span t-esc="'%.2f' % (sl_line.total - sl_line.amount)"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>
                                        </tr>

                                        <t t-set="vd_line"
                                        t-value="o.line_ids.filtered(lambda l: l.code == 'VD')[:1]"/>

                                        <tr>
                                            <td>Vacation ($)</td>

                                            <td class="text-right">
                                                <t t-if="vd_line">
                                                    <span t-esc="'%.2f' % vd_line.total"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>

                                            <td class="text-right">
                                                <t t-if="vd_line">
                                                    <span t-esc="'%.2f' % vd_line.amount"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>

                                            <td class="text-right">
                                                <t t-if="vd_line">
                                                    <span t-esc="'%.2f' % (vd_line.total - vd_line.amount)"/>
                                                </t>
                                                <t t-else="">0.00</t>
                                            </td>
                                        </tr>

                                    </tbody>

                                </table>

                            </td>

                        </tr>
                    </table>

                </div>

            </t>
        </t>
    </t>
</template>
</odoo>
