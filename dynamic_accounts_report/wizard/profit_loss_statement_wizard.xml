<odoo>

    <record id="view_profit_loss_statement_wizard_form" model="ir.ui.view">
        <field name="name">profit.loss.statement.wizard.form</field>
        <field name="model">profit.loss.statement.wizard</field>
        <field name="arch" type="xml">

            <form string="Profit and Loss Statement">

                <group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                </group>

                <footer>

                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>

        </field>

    </record>


    <record id="action_profit_loss_statement" model="ir.actions.act_window">
        <field name="name">Profit and Loss Statement</field>
        <field name="res_model">profit.loss.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>