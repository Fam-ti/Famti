<odoo>

    <record id="view_credit_card_payment_report_wizard_form" model="ir.ui.view">
        <field name="name"> credit.card.payment.report.wizard.form</field>
        <field name="model">credit.card.payment.report.wizard</field>
        <field name="arch" type="xml">

            <form string="Credit Card Payment Report">

                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="payment_type"/>
                    </group>
                </group>

                <footer>

                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>

        </field>

    </record>


    <record id="action_credit_card_payment_report" model="ir.actions.act_window">
        <field name="name">Credit Card Payment Report</field>
        <field name="res_model">credit.card.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>