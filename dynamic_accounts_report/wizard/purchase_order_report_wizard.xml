<odoo>

    <record id="view_purchase_order_report_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.report.wizard.form</field>
        <field name="model">purchase.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Report">

                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group>
                        <field name="partner_ids"
                               widget="many2many_tags"/>
                    </group>
                </group>

                <footer>

                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>
        </field>
    </record>


    <record id="action_purchase_order_report" model="ir.actions.act_window">
        <field name="name">Purchase Order Report</field>
        <field name="res_model">purchase.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>