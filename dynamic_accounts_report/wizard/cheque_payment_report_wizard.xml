<odoo>

    <record id="view_cheque_payment_report_wizard_form" model="ir.ui.view">
        <field name="name">cheque.payment.report.wizard.form</field>
        <field name="model">cheque.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Cheque Payment Report">

                <group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group>
                        <field name="partner_ids"
                               widget="many2many_tags"/>
                    </group>

                </group>

                <footer>

                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>

        </field>

    </record>



    <record id="action_cheque_payment_report" model="ir.actions.act_window">
        <field name="name">Cheque Payment Report</field>
        <field name="res_model">cheque.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>