
<odoo>

    <record id="view_unpaid_invoice_bill_report_wizard_form" model="ir.ui.view">
        <field name="name">unpaid.invoice.bill.report.wizard.form</field>
        <field name="model">unpaid.invoice.bill.report.wizard</field>
        <field name="arch" type="xml">

            <form string="Unpaid Invoice/Bills Report">

                <group>

                    <group>
                        <field name="report_type"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group>
                        <field name="partner_ids"
                               widget="many2many_tags"/>
                    </group>

                </group>

                <footer>

                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>

        </field>

    </record>

    <record id="action_unpaid_invoice_bill_report" model="ir.actions.act_window">
        <field name="name">Unpaid Invoice/Bills Report</field>
        <field name="res_model">unpaid.invoice.bill.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    

</odoo>