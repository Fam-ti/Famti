<odoo>

    <record id="view_customer_contact_list_wizard_form" model="ir.ui.view">
        <field name="name">customer.contact.list.wizard.form</field>
        <field name="model">customer.contact.list.wizard</field>
        <field name="arch" type="xml">

            <form string="Customer Contact List">

                <group>

                    <field name="customer_ids"
                           widget="many2many_tags"/>

                </group>

                <footer>

                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>

                </footer>

            </form>

        </field>

    </record>


    <record id="action_customer_contact_list" model="ir.actions.act_window">
        <field name="name">Customer Contact List</field>
        <field name="res_model">customer.contact.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>