<odoo>
    <data>
         <record id="stock_lot_form_view_inherit" model="ir.ui.view">
            <field name="name">stock.lot.view.form.inherit</field>
            <field name="model">stock.lot</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="before">
                    <header>
                        <field name="qc_status" widget="statusbar" statusbar_visible="pending,passed,failed"/>
                    <button
                        name="action_coa_passed"
                        type="object"
                        string="Passed"
                        class="oe_highlight btn-success" invisible="qc_status in ['passed','failed']"/>
                    <button
                        name="action_coa_failed"
                        type="object"
                        string="Failed"
                        class="oe_highlight btn-danger" invisible="qc_status == 'failed'"/>
                    <button
                        name="action_reset_to_draft"
                        type="object"
                        string="Reset To Draft"
                        class="oe_highlight btn-info" invisible="qc_status != 'failed'"/>
                    </header>
                </xpath>

                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="product_code" readonly="0"/>
                    <field name="mo_product_code" readonly="0"/>
                </xpath>

                <xpath expr="//sheet/notebook" position="before">
                    <group string="QC Details" col="2">
                        <group>
                            <field name="treatment_in"/>
                            <field name="grade_type"/>
                            <label for="thickness" />
                            <div class="o_row">
                                <field name="thickness"/>
                                <field name="thickness_uom"/>
                            </div>
                            <label for="weight" />
                            <div class="o_row">
                                <field name="weight"/>
                                <field name="weight_uom"/>
                            </div>
                            <field name="core_id"/>
                            <field name="lot_number" invisible="1"/>
                            <field name="pallet_no"/>
                            <field name="film"/>
                            <field name="film_type"/>
                            <field name="film_description"/>
                            <field name="qc_remark"/>

                        </group>
                        <group>
                            <field name="treatment_out"/>
                            <label for="width_val"/>
                            <div class="o_row">
                                <field name="width_val"/>
                                <field name="width_uom"/>
                            </div>
                            <label for="length_val" />
                            <div class="o_row">
                                <field name="length_val"/>
                                <field name="length_uom"/>
                            </div>
                            <field name="qc_status" invisible="1"/>
                            <field name="upload_doc"/>
                            <field name="no_of_joint"/>
                            <field name="aging"/>
                            <field name="received_date"/>
                            <field name="supplier_name"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>




        <record id="stock_lot_list_view_inherit" model="ir.ui.view">
        <field name="name">stock.lot.view.list.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
                <xpath expr="//list/field[@name='company_id']" position="after">
                    <field name="grade_type" widget="badge"
                            decoration-success="grade_type == 'a'" decoration-danger="grade_type == 'b'"/>
                    <field name="qc_status" widget="badge"  decoration-info="qc_status == 'pending'"
                            decoration-success="qc_status == 'passed'" decoration-danger="qc_status == 'failed'"/>
                </xpath>
        </field>
        </record>


        <record id="view_stock_move_operations_inherit_excel_btn" model="ir.ui.view">
                <field name="name">stock.move.operations.form.inherit.excel.btn</field>
                <field name="model">stock.move</field>
                <field name="inherit_id" ref="stock.view_stock_move_operations"/>
                <field name="arch" type="xml">
                    <xpath expr="//div[@class='o_row']" position="after">
                        <span>
                            <button
                                type="action"
                                class="btn btn-outline-primary btn-sm ms-2"
                                name="%(action_open_excel_wiz)d"
                                string="Upload csv"/>
                        </span>
                    </xpath>

                </field>
            </record>


          <record id="view_stock_move_line_form_inherit_film" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherit.film</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id']" position="after">
                <field name="film"/>
                <field name="film_type"/>
                <field name="category"/>
                <field name="weight"/>
                <field name="weight_uom"/>
            </xpath>

            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="treatment_in"/>
                <field name="treatment_out"/>
                <field name="thickness"/>
                <field name="thickness_uom"/>
                <field name="width"/>
                <field name="width_uom"/>
                <field name="core_id"/>
                <field name="length"/>
                <field name="length_uom"/>
            </xpath>

        </field>
    </record>

    <record id="view_stock_lot_search_inherit" model="ir.ui.view">
	    <field name="name">stock.lot.search.inherit</field>
	    <field name="model">stock.lot</field>
	    <field name="inherit_id" ref="stock.search_product_lot_filter"/>
	    <field name="arch" type="xml">

		<xpath expr="//search" position="inside">

		    <filter name="fm_stock_only"
		            string="FM Stock"
		            domain="[('location_id.complete_name', 'like', 'FM/Stock/%')]"/>

		</xpath>

		<xpath expr="//search/group" position="inside">

		    <filter name="group_parent_location"
		            string="Parent Location"
		            context="{'group_by':'location_id'}"/>

		</xpath>

	    </field>
	</record>

    <record id="stock.action_production_lot_form" model="ir.actions.act_window">
	    <field name="context">
		{
		    'search_default_fm_stock_only': 1,
		    'search_default_group_parent_location': 1,
		    'display_complete': True
		}
	    </field>
	</record>

    <record id="view_stock_move_line_roll_number" model="ir.ui.view">
        <field name="name">stock.move.line.roll.number</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="string">Roll Number</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_quant_package_form_roll_number" model="ir.ui.view">
        <field name="name">stock.quant.package.form.roll.number</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="string">Roll Number</attribute>
            </xpath>

        </field>
    </record>
    
    <record id="view_stock_quant_tree_editable_roll_number" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.roll.number</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="string">Roll Number</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_stock_quant_tree_simple_roll_label" model="ir.ui.view">
        <field name="name">stock.quant.tree.simple.roll.label</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="attributes">
                <attribute name="string">Roll Number</attribute>
            </field>
        </field>
    </record>


    </data>
</odoo>
