<odoo>
    <data>
        <record id="product_template_form_view_roll_number" model="ir.ui.view">
    <field name="name">product.template.form.roll.number</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">

<!--        <xpath expr="//div[contains(@class, 'oe_title')]//label[@for='name']" position="attributes">-->
<!--            <attribute name="string">Roll Number</attribute>-->
<!--        </xpath>-->
<!--        <xpath expr="//div[contains(@class, 'oe_title')]//label[@for='categ_id']" position="attributes">-->
<!--            <attribute name="string">Material Type</attribute>-->
<!--        </xpath>-->
<!--         <xpath expr="//field[@name='categ_id']" position="attributes">-->
<!--            <attribute name="string">Material Type</attribute>-->
<!--        </xpath>-->
        <xpath expr="//field[@name='categ_id']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
</record>

         <record id="product_template_form_view_inherit" model="ir.ui.view">
            <field name="name">product.temp.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Product Code</attribute>
                </xpath>
                <xpath expr="//form//field[@name='name']" position="attributes">
                    <attribute name="string">Roll Number</attribute>
                </xpath>
                <xpath expr="//field[@name='lot_valuated']" position="after">
                    <field name="mo_serial_no"/>
                    <field name = "is_consumables"/>
                    <field name = "mo_service_cost"/>
                </xpath>

                <xpath expr="//page[@name='general_information']/group" position="inside">

                    <separator string="Product Reference" colspan="4"/>

                    <group>
                        <field name="supplier_name"/>
                        <field name="material_type"/>
                        <field name="film_type" invisible="1"/>
                        <field name="type_reference"/>
                        <field name="pallet_no"/>
                        <field name="no_of_joint"/>
                        <field name="received_date"/>
                        <label for="thickness_val"/>
                        <div class="o_row">
                            <field name="thickness_val"/>
                            <field name="thickness_uom"/>
                        </div>
                    </group>

                    <group>
                        <field name="treatment_in_selection"/>
                        <field name="treatment_out_selection"/>
                        <field name="density"/>
                        <field name="length"/>
                        <field name="aging"/>
                        <label for="width_val"/>
                        <div class="o_row">
                            <field name="width_val"/>
                            <field name="width_uom"/>
                        </div>
                    </group>
                    <label for="film_description"/>
                    <div>
                        <field name="film_description"/>
                    </div>

                </xpath>
                <xpath expr="//button[@name='action_open_product_lot']//span[contains(@class, 'o_stat_text')]" position="replace">
                    <span class="o_stat_text">Roll Numbers</span>
                </xpath>
            </field>
        </record>


        <record id="view_product_form_inherit_mo_serial" model="ir.ui.view">
            <field name="name">product.product.form.mo.serial</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_valuated']" position="after">
                    <field name="mo_serial_no"/>
                    <field name = "is_consumables"/>
                    <field name = "mo_service_cost"/>
                </xpath>
                <xpath expr="//field[@name='default_code']" position="attributes">
                    <attribute name="string">SKU</attribute>
                </xpath>

                <xpath expr="//page[@name='general_information']/group" position="inside">

                    <separator string="Product Reference" colspan="4"/>

                    <group>
                        <field name="supplier_name"/>
                        <field name="film_type"/>
                        <field name="type_reference"/>
                    </group>

                    <group>
                        <field name="treatment_in"/>
                        <field name="treatment_out"/>
                        <field name="low_stock_alert_sent"/>
                    </group>
                    <label for="film_description"/>
                    <div>
                        <field name="film_description"/>
                    </div>

                </xpath>
                
            </field>
        </record>


    </data>
</odoo>
