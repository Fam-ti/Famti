        <record id="hr_recruitment.menu_hr_candidate" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('group_hide_candidate_menu_for_HR')])]"/>
        </record>

        <record id="hr_recruitment.menu_hr_recruitment_configuration" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('group_for_hr_executive')])]"/>
        </record>

