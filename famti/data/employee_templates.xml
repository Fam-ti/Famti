<td width="33%">

<div class="label">First Name-</div>

<div class="field-line">

<span t-esc="(o.candidate_id.partner_name or '').split(' ')[0]"/>

</div>

</td>

<td width="33%">

<div class="label">Last Name-</div>

<div class="field-line">

<span t-esc="' '.join((o.candidate_id.partner_name or '').split(' ')[1:])"/>

</div>

</td>

<td width="34%">

<div class="label">Preferred Name-</div>

<div class="field-line">

<span t-esc="o.candidate_id.partner_name"/>

</div>

</td>

