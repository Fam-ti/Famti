<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="report_new_hire_template">

<t t-call="web.html_container">

<t t-foreach="docs" t-as="o">

<div class="page" style="font-family:Arial;padding:20px 35px;font-size:13px;">

<style>

.page{
    width:100%;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-left:20px;
    margin-right:-20px;
}

td{
    vertical-align:top;
    padding-top:5px;
}

.field-line{
    border-bottom:1px solid #999;
    min-height:24px;
    padding-top:3px;
}

.label{
    font-weight:bold;
}

.checkbox{
    display:inline-block;
    width:12px;
    height:12px;
    border:1px solid black;
    margin-left:5px;
    margin-right:5px;
}

/* FIX ONLY HEADER SPACE */
.title{
    text-align:center;
    margin-top:0px;        /* remove negative space */
    margin-bottom:15px;
    padding-top:0px;
}

.footer{
    margin-top:60px;
    font-size:12px;
}

</style>

<!-- HEADER -->
<div class="title">

    <img
        t-if="o.company_id.logo"
        t-att-src="image_data_uri(o.company_id.logo)"
        style="
            max-height:90px;
            width:auto;
            display:block;
            margin:0 auto 10px auto;
        "
    />

    <div style="
        font-size:20px;
        font-weight:bold;
        text-decoration:underline;
        margin-top:0px;
    ">
        NEW HIRE/REHIRE EMPLOYEE FORM
    </div>

</div>

<table>

