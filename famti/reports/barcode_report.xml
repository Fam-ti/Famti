    <template id="report_barcode_labels">
        <t t-call="web.basic_layout">

            <t t-set="copies" t-value="env.context.get('copies', 1)"/>
            <t t-set="print_format" t-value="env.context.get('print_format', 'dymo')"/>

            <t t-set="format_specs" t-value="{
                'dymo': {'width': 48, 'height': 160, 'title_fs': 14, 'serial_fs': 14, 'pallet_fs': 11, 'bc_w': 260, 'bc_h': 60},
                '4x12': {'width': 22, 'height': 120, 'title_fs': 10, 'serial_fs': 11, 'pallet_fs': 8,  'bc_w': 150, 'bc_h': 35},
                '4x7':  {'width': 22, 'height': 170, 'title_fs': 11, 'serial_fs': 12, 'pallet_fs': 9,  'bc_w': 170, 'bc_h': 45},
                '2x7':  {'width': 45, 'height': 170, 'title_fs': 13, 'serial_fs': 14, 'pallet_fs': 10, 'bc_w': 220, 'bc_h': 55},
                '3x8':  {'width': 30, 'height': 150, 'title_fs': 12, 'serial_fs': 13, 'pallet_fs': 9,  'bc_w': 190, 'bc_h': 48},
                '5x10': {'width': 18, 'height': 130, 'title_fs': 9,  'serial_fs': 10, 'pallet_fs': 7,  'bc_w': 130, 'bc_h': 30},
            }"/>

            <t t-set="spec" t-value="format_specs.get(print_format, format_specs['dymo'])"/>

            <t t-foreach="docs" t-as="doc">
                <t t-foreach="range(copies)" t-as="copy">
                    <t t-foreach="doc.line_ids" t-as="line">
                
                        <div t-attf-style="
                            width: {{spec['width']}}%;
                            height: {{spec['height']}}px;
                            border: 1px solid black;
                            padding: 6px;
                            margin: 5px;
                            float: left;
                            box-sizing: border-box;
                            page-break-inside: avoid;
                            overflow: hidden;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            align-items: center;
                            text-align: center;
                        ">
                            <div t-attf-style="
                                font-size: {{spec['title_fs']}}px;
                                font-weight: bold;
                                line-height: 1.1;
                                max-height: {{spec['title_fs'] * 1.2}}px;
                                overflow: hidden;
                                word-wrap: break-word;
                                white-space: normal;
                                width: 100%;
                                text-align: left;
                            ">
                                <span t-esc="line.product_id.display_name"/>
                            </div>

                            <div t-attf-style="font-size: {{spec['serial_fs']}}px; font-weight: bold;">
                                <span t-esc="line.serial_number"/>
                            </div>

                            <div style="display:flex; justify-content:center; align-items:center; width:100%;">
                                <div t-field="line.barcode_value"
                                    t-options="{'widget': 'barcode', 'width': spec['bc_w'], 'height': spec['bc_h']}"/>
                            </div>

                            <div t-attf-style="font-size: {{spec['pallet_fs']}}px; word-wrap: break-word; width: 100%;">
                                <span t-esc="line.pallet_number"/>
                            </div>

                        </div>

                    </t>
                </t>
            </t>

            <div style="clear:both;"/>

        </t>
    </template>

