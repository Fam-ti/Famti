<odoo>
    <record id="view_barcode_label_wizard_form" model="ir.ui.view">
        <field name="name">barcode.label.wizard.form</field>
        <field name="model">barcode.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Labels">
                <group>
                    <group>
                        <field name="copies"/>
                        <field name="print_format" widget="radio"/>
                    </group>
                </group>

                <footer>
                    <button name="action_print"
                            string="Print"
                            type="object"
                            class="btn-primary"/>

                    <button string="Discard"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>