<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record
        id="view_product_catalog_import_wizard_form" model="ir.ui.view">
        <field name="name">product.catalog.import.wizard.form</field>
    <field name="model">product.catalog.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Catalogue Import">
                <sheet>

                    <group>

                        <field
                            name="file"
                            filename="filename"
                        />

                        <field
                            name="filename"
                            invisible="1"
                        />

                    </group>

                    <group
                        invisible="not summary"
                    >

                        <field
                            name="summary"
                            nolabel="1"
                        />

                    </group>

                    <group
                        invisible="not result_file"
                    >

                        <field
                            name="result_file"
                            filename="result_filename" invisible="1"
                        />

                        <field
                            name="result_filename"
                            invisible="1"
                        />

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_import"
                        type="object"
                        string="Import Catalogue"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <record id="action_product_catalog_import_wizard" model="ir.actions.act_window">
        <field name="name">Product Catalogue Import</field>
        <field name="res_model">product.catalog.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_product_catalog_import"
        name="Product Catalogue Import"
        parent="menu_import_root"
        action="action_product_catalog_import_wizard"
        sequence="2"
        groups="group_product_catalog_import_access"
    />



