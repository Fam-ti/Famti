<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_customer_import_wizard" model="ir.ui.view">

        <field name="name">customer.import.wizard.form</field>

        <field name="model">customer.import.wizard</field>

        <field name="arch" type="xml">

            <form string="Import Customers">

                <group>

                    <field
                        name="file"
                        filename="filename"
                    />

                    <field
                        name="filename"
                        invisible="1"
                    />

                </group>

                <footer>

                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>

    </record>


    <record id="action_customer_import" model="ir.actions.act_window">

        <field name="name">Import Customers</field>

        <field name="res_model">customer.import.wizard</field>

        <field name="view_mode">form</field>

        <field name="target">new</field>

    </record>


    <menuitem
        id="menu_customer_import"
        name="Import Customers"
        parent="contacts.menu_contacts"
        action="action_customer_import"
        sequence="90"
    />

</odoo>